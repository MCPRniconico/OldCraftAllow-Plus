    "sources": "https://github.com/MCPRniconico/OldCraftAllow-Plus",
    "issues": "https://github.com/MCPRniconico/OldCraftAllow-Plus/issues"
  },

  "license": "MIT",

  "icon": "assets/oldcraftallowplus/icon.png",

  "environment": "*",

  "entrypoints": {
